#include "ui/menudef.h"
{
 menuDef {
  name "OpenCJ scoreboard frame"
  fullScreen MENU_FALSE
  rect 0 0 640 480
  visible when (dvarInt("opencj_sb_held") && !ui_active());
  itemDef { name background rect 70 0 500 90 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")) exp rect H (dvarFloat("opencj_sb_height")) style WINDOW_STYLE_FILLED backcolor .015 .025 .03 .48 visible 1 decoration }
  itemDef { name accent rect 70 0 500 1 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")) style WINDOW_STYLE_FILLED backcolor 0 .7 .8 .85  visible 1 decoration }
  itemDef { name map rect 80 0 480 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+3) type ITEM_TYPE_TEXT dvar "opencj_sb_map" textfont UI_FONT_NORMAL textscale .22 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .8 .9 .92 1 visible 1 decoration }
  itemDef { name jumpers rect 80 0 200 13 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+18) type ITEM_TYPE_TEXT dvar "opencj_sb_jumpers" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 0 .8 .9 1 visible 1 decoration }
  itemDef { name headPlayer rect 115 0 73 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Player" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headRoute rect 190 0 90 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Route" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headDone rect 284 0 29 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Progress" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headTime rect 315 0 38 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Time" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headRPG rect 354 0 22 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "RPG" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headModes rect 381 0 76 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Modes" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headXP rect 458 0 32 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "XP" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headPing rect 496 0 70 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Ping" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name spectators rect 80 0 480 14 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_specy")) type ITEM_TYPE_TEXT dvar "opencj_sb_spectators" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 0 .8 .9 1 visible 1 decoration }
  itemDef { name serverName rect 80 0 480 13 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+3) type ITEM_TYPE_TEXT dvar "opencj_sb_servername" textfont UI_FONT_NORMAL textscale .18 textalign ITEM_ALIGN_MIDDLE_RIGHT forecolor .6 .75 .78 1 visible 1 decoration }
  itemDef { name hostname rect 80 0 480 13 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_footer")) type ITEM_TYPE_TEXT dvar "opencj_sb_hostname" textfont UI_FONT_NORMAL textscale .18 textalign ITEM_ALIGN_MIDDLE_RIGHT forecolor .6 .75 .78 1 visible 1 decoration }
 }
 menuDef {
  name "OpenCJ scoreboard rows 0"
  fullScreen MENU_FALSE
  rect 0 0 640 480
  visible when (dvarInt("opencj_sb_held") && !ui_active());
  itemDef { name row0 rect 77 0 486 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) style WINDOW_STYLE_FILLED backcolor .03 .07 .08 .25  visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name self0 rect 77 0 1 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) style WINDOW_STYLE_FILLED backcolor 0 .8 .9 .9  visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_self")) decoration }
  itemDef { name rank0 rect 79 0 16 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_r0_y")) exp rect W (dvarFloat("opencj_sb_rowheight")) exp rect H (dvarFloat("opencj_sb_rowheight")) style WINDOW_STYLE_FILLED backcolor .12 .18 .2 .7 border WINDOW_BORDER_FULL bordersize .5 bordercolor .45 .55 .6 .7 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name flag0 rect 99 0 12 12 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_r0_y")+(dvarFloat("opencj_sb_rowheight")-12)/2) style WINDOW_STYLE_DVAR_SHADER dvar "opencj_sb_r0_flag" forecolor 1 1 1 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarString("opencj_sb_r0_flag") != "") decoration }
  itemDef { name r0_country rect 97 0 17 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_country" textfont UI_FONT_NORMAL textscale .17 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .55 .75 .78 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarString("opencj_sb_r0_flag") == "") decoration }
  itemDef { name r0_name rect 115 0 73 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_name" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 1 1 1 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_route rect 190 0 90 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_route" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .8 .9 .9 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_time rect 315 0 38 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_time" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .85 .9 .92 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_rpg rect 354 0 22 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_rpg" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .85 .9 .92 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_pingGood rect 496 0 70 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_pingText" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .92 .93 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_ping") < 100) decoration }
  itemDef { name r0_pingMedium rect 496 0 70 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_pingText" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .85 .65 .4 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_ping") >= 100 && dvarInt("opencj_sb_r0_ping") <= 150) decoration }
  itemDef { name r0_pingHigh rect 496 0 70 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_pingText" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .85 .45 .43 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_ping") > 150) decoration }
  itemDef { name progress0 rect 284 0 29 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT exp text (dvarString("opencj_sb_r0_progress") + "%") textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .94 .95 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_progress") >= 0) decoration }
  itemDef { name anyProgress0 rect 284 0 29 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT exp text ("Any" + "%") textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .94 .95 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_progress") < 0 && dvarInt("opencj_sb_r0_any")) decoration }
  itemDef { name noProgress0 rect 284 0 29 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT text "-" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .94 .95 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_progress") < 0 && !dvarInt("opencj_sb_r0_any")) decoration }
  itemDef { name xp0 rect 458 0 32 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT text "-" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .45 .55 .6 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_fps_classic rect 381 0 16 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) exp rect W (dvarFloat("opencj_sb_rowheight")) style WINDOW_STYLE_SHADER background "opencj_icon_fps_classic" forecolor 1 1 1 .95 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_fps") == 1) decoration }
  itemDef { name r0_fps_standard rect 381 0 16 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) exp rect W (dvarFloat("opencj_sb_rowheight")) style WINDOW_STYLE_SHADER background "opencj_icon_fps_standard" forecolor 1 1 1 .95 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_fps") == 2) decoration }
