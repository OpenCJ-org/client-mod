#include "ui/menudef.h"
{
 menuDef {
  name "OpenCJ scoreboard frame"
  fullScreen MENU_FALSE
  rect 0 0 640 480
  visible when (dvarInt("opencj_sb_held") && (!ui_active() || menuIsOpen("opencj_scoreboard_input")));
  itemDef { name background rect 70 0 500 90 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")) exp rect H (dvarFloat("opencj_sb_height")) style WINDOW_STYLE_FILLED backcolor .015 .025 .03 .48 visible 1 decoration }
  itemDef { name accent rect 70 0 500 1 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")) style WINDOW_STYLE_FILLED backcolor 0 .7 .8 .85  visible 1 decoration }
  itemDef { name map rect 80 0 480 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+3) type ITEM_TYPE_TEXT dvar "opencj_sb_map" textfont UI_FONT_NORMAL textscale .22 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .8 .9 .92 1 visible 1 decoration }
  itemDef { name jumpers rect 80 0 200 13 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+18) type ITEM_TYPE_TEXT dvar "opencj_sb_section" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 0 .8 .9 1 visible 1 decoration }
  itemDef { name headPlayer rect 119 0 69 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Player" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headRoute rect 190 0 90 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Route" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headDone rect 284 0 29 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Progress" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headTime rect 315 0 38 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Time" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headRPG rect 354 0 22 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "RPG" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headModes rect 373 0 84 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Modes" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headPoints rect 464 0 32 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Points" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name headPing rect 500 0 66 11 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+31) type ITEM_TYPE_TEXT text "Ping" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .78 .8 1 visible 1 decoration }
  itemDef { name spectators rect 80 0 480 14 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_specy")) type ITEM_TYPE_TEXT dvar "opencj_sb_spectators" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 0 .8 .9 1 visible when (dvarInt("opencj_sb_spec_visible")) decoration }
  itemDef { name serverName rect 80 0 480 13 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_top")+3) type ITEM_TYPE_TEXT dvar "opencj_sb_servername" textfont UI_FONT_NORMAL textscale .18 textalign ITEM_ALIGN_MIDDLE_RIGHT forecolor .6 .75 .78 1 visible 1 decoration }
  itemDef { name hostname rect 80 0 480 13 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_footer")) type ITEM_TYPE_TEXT dvar "opencj_sb_hostname" textfont UI_FONT_NORMAL textscale .18 textalign ITEM_ALIGN_MIDDLE_RIGHT forecolor .6 .75 .78 1 visible 1 decoration }
  itemDef { name scrollTrack rect 565 0 2 100 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_track_y")) exp rect H (dvarFloat("opencj_sb_track_h")) style WINDOW_STYLE_FILLED backcolor .15 .3 .32 .5 visible when (dvarInt("opencj_sb_scroll_visible")) decoration }
  itemDef { name scrollThumb rect 565 0 2 40 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_thumb_y")) exp rect H (dvarFloat("opencj_sb_thumb_h")) style WINDOW_STYLE_FILLED backcolor 0 .75 .85 .8 visible when (dvarInt("opencj_sb_scroll_visible")) decoration }
  itemDef { name scrollLabel rect 80 0 240 13 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_footer")) type ITEM_TYPE_TEXT dvar "opencj_sb_scroll_label" textfont UI_FONT_NORMAL textscale .17 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .6 .75 .78 1 visible when (dvarInt("opencj_sb_scroll_visible")) decoration }

 }
 menuDef {
  name "OpenCJ scoreboard rows 0"
  fullScreen MENU_FALSE
  rect 0 0 640 480
  visible when (dvarInt("opencj_sb_held") && (!ui_active() || menuIsOpen("opencj_scoreboard_input")));
  itemDef { name row0 rect 77 0 486 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) style WINDOW_STYLE_FILLED backcolor .03 .07 .08 .25  visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name self0 rect 77 0 1 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) style WINDOW_STYLE_FILLED backcolor 0 .8 .9 .9  visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_self")) decoration }
  itemDef { name rank0 rect 79 0 16 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_r0_y")) exp rect W (dvarFloat("opencj_sb_rowheight")) exp rect H (dvarFloat("opencj_sb_rowheight")) style WINDOW_STYLE_DVAR_SHADER dvar "opencj_sb_r0_rank" forecolor 1 1 1 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name flag0 rect 103 0 12 12 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect Y (dvarFloat("opencj_sb_r0_y")+(dvarFloat("opencj_sb_rowheight")-12)/2) style WINDOW_STYLE_DVAR_SHADER dvar "opencj_sb_r0_flag" forecolor 1 1 1 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarString("opencj_sb_r0_flag") != "") decoration }
  itemDef { name r0_country rect 103 0 13 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_country" textfont UI_FONT_NORMAL textscale .17 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .55 .75 .78 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarString("opencj_sb_r0_flag") == "") decoration }
  itemDef { name r0_name rect 119 0 69 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_name" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 1 1 1 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_route rect 190 0 90 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_route" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .8 .9 .9 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_time rect 315 0 38 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_time" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .85 .9 .92 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_rpg rect 354 0 22 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_rpg" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .85 .9 .92 1 visible when (dvarInt("opencj_sb_r0_exists")) decoration }
  itemDef { name r0_pingGood rect 500 0 66 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_pingText" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .92 .93 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_ping") < 100) decoration }
  itemDef { name r0_pingMedium rect 500 0 66 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_pingText" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .85 .65 .4 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_ping") >= 100 && dvarInt("opencj_sb_r0_ping") <= 150) decoration }
  itemDef { name r0_pingHigh rect 500 0 66 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT dvar "opencj_sb_r0_pingText" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .85 .45 .43 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_ping") > 150) decoration }
  itemDef { name progress0 rect 284 0 29 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT exp text (dvarString("opencj_sb_r0_progress") + "%") textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .94 .95 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_progress") >= 0) decoration }
  itemDef { name anyProgress0 rect 284 0 29 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT exp text ("Any" + "%") textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .94 .95 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_progress") < 0 && dvarInt("opencj_sb_r0_any")) decoration }
  itemDef { name noProgress0 rect 284 0 29 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_rowheight")) exp rect Y (dvarFloat("opencj_sb_r0_y")) type ITEM_TYPE_TEXT text "-" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .94 .95 1 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_progress") < 0 && !dvarInt("opencj_sb_r0_any")) decoration }
