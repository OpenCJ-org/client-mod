  itemDef { name r0_fps_classic rect 373 0 20 20 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_iconsize")) exp rect Y (dvarFloat("opencj_sb_r0_y")+(dvarFloat("opencj_sb_rowheight")-dvarFloat("opencj_sb_iconsize"))/2) exp rect W (dvarFloat("opencj_sb_iconsize")) style WINDOW_STYLE_SHADER background "opencj_icon_fps_classic" forecolor 1 1 1 .95 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_fps") == 1) decoration }
  itemDef { name r0_fps_standard rect 373 0 20 20 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("opencj_sb_iconsize")) exp rect Y (dvarFloat("opencj_sb_r0_y")+(dvarFloat("opencj_sb_rowheight")-dvarFloat("opencj_sb_iconsize"))/2) exp rect W (dvarFloat("opencj_sb_iconsize")) style WINDOW_STYLE_SHADER background "opencj_icon_fps_standard" forecolor 1 1 1 .95 visible when (dvarInt("opencj_sb_r0_exists") && dvarInt("opencj_sb_r0_fps") == 2) decoration }
