#include "ui/menudef.h"
#include "ui_mp/scriptmenus/opencj_common.inc"

// Each row stages a client value; the server applies validated settings on Apply.
#define GFX_ROW(_key, _label, _values, _action, _x, _y, _hint) \
    FIXED_RECT_TXT(1, _label, UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL, 0.23, ITEM_ALIGN_MIDDLE_LEFT, 0, 0, NO_COLOR, WHITE_COLOR, _x, _y, 140, 20) \
    itemDef { \
        name _key \
        type ITEM_TYPE_MULTI \
        style WINDOW_STYLE_FILLED \
        rect DEFAULT_RECT(0 0 96 20) \
        origin (_x + 144) _y \
        dvar "opencj_gfx_edit_"#_key \
        dvarFloatList _values \
        textfont UI_FONT_NORMAL \
        textscale 0.23 \
        textalign ITEM_ALIGN_MIDDLE_CENTER \
        forecolor WHITE_COLOR \
        backcolor BLACK_TRANSPARENT_COLOR_03 \
        visible 1 \
        mouseEnter { setitemcolor _key backcolor BRIGHT_BLUE_COLOR_01; setdvar opencj_gfx_hint _hint; } \
        mouseExit { setitemcolor _key backcolor BLACK_TRANSPARENT_COLOR_03; setdvar opencj_gfx_hint ""; } \
        action { play "mouse_click"; setdvar opencj_gfx_preset "Custom"; _action } \
    }

// Reset both the preview and pending server edits to the current player settings.
#define GFX_RESET \
    scriptMenuResponse "begin"; \
    setdvar opencj_gfx_preset "Custom"; \
    setdvar opencj_gfx_hint ""; \
    execnow "setfromdvar opencj_gfx_edit_fullbright r_fullbright"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_specular r_specular"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_normal r_normal"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_detail r_detail"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_decals r_drawDecals"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_shadows sm_enable"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_glow r_glow_allowed"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_blur opencj_gfx_blur"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_dof r_dof_enable"; \
    execnow "setfromdvar opencj_gfx_edit_fx fx_enable"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_fog r_fog"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_sun r_drawSun"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_water r_drawWater"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_entities dynEnt_active"; \
    setdvar opencj_gfx_edit_gfx_lod 3; \
    execnow "setfromdvar opencj_gfx_edit_gfx_distance r_zfar"; \
    execnow "setfromdvar opencj_gfx_edit_viewbob bg_bobmax"; \
    execnow "setfromdvar opencj_gfx_edit_fov opencj_gfx_fov"; \
    execnow "setfromdvar opencj_gfx_edit_gfx_hidemode opencj_gfx_hidemode"; \
    execnow "setfromdvar opencj_gfx_edit_hideradius opencj_gfx_hideradius"; \
    execNowOnDvarIntValue opencj_gfx_specular 2 "set opencj_gfx_edit_gfx_specular 2"; \
    execNowOnDvarIntValue opencj_gfx_shadows 2 "set opencj_gfx_edit_gfx_shadows 2"; \
    execNowOnDvarIntValue opencj_gfx_edit_hideradius 0 "set opencj_gfx_edit_hideradius 60";


