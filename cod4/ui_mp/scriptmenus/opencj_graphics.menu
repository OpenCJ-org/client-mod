        BUTTON_RECT_TXT_ACTION_BG(gfx_cancel, "Cancel", play "mouse_click"; scriptMenuResponse "cancel"; close self; close opencj_ingame, NO_COLOR, WHITE_COLOR, UI_FONT_NORMAL, 0.24, 402, 414, 80, 22)
        BUTTON_RECT_TXT_ACTION_BG(gfx_apply, "Apply", play "mouse_click"; scriptMenuResponse "apply"; close self; close opencj_ingame, BRIGHT_BLUE_COLOR_01, WHITE_COLOR, UI_FONT_NORMAL, 0.24, 498, 414, 80, 22)
    }
}
