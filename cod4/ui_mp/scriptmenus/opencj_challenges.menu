#include "ui/menudef.h"
{
 menuDef {
  name opencj_challenges
  rect 0 0 640 480
  style WINDOW_STYLE_EMPTY
  focuscolor 1 1 1 1
  onOpen { setDvar "ocj_ch_busy" "1"; scriptMenuResponse "open"; }
  onEsc { close self; open openCJ_ingame; }
  itemDef { name panel rect 24 52 592 388 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT exp rect H (dvarFloat("ocj_ch_height")) style WINDOW_STYLE_FILLED backcolor .015 .025 .03 .94 visible 1 decoration }
  itemDef { name accent rect 24 52 592 2 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT style WINDOW_STYLE_FILLED backcolor 0 .75 .85 1 visible 1 decoration }
  itemDef { name heading rect 36 60 460 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT text "CHALLENGES" textfont UI_FONT_NORMAL textscale .3 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 0 .85 .95 1 visible 1 decoration  }
  itemDef { name summary rect 60 85 532 18 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT dvar "ocj_ch_summary" textfont UI_FONT_NORMAL textscale .19 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .8 .88 .9 1 visible 1 decoration  }
  itemDef { name exit rect 582 60 22 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED backcolor .55 .12 .12 .8 text "X" textfont UI_FONT_NORMAL textscale .23 textalign ITEM_ALIGN_MIDDLE_CENTER forecolor 1 1 1 1 visible 1 action { play "mouse_click"; close self; open openCJ_ingame; } }
  itemDef { name tier1 rect 122 110 40 40 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_BUTTON style WINDOW_STYLE_SHADER background "opencj_rank_1" forecolor 1 1 1 1 visible 1 mouseEnter { setitemcolor tier1 forecolor .6 1 1 1; } mouseExit { setitemcolor tier1 forecolor 1 1 1 1; } action { play "mouse_click"; scriptMenuResponse "1"; } }
