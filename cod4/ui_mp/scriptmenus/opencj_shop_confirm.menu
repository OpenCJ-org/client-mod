#include "ui/menudef.h"
{
 menuDef { name opencj_shop_confirm rect 0 0 640 480 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT style WINDOW_STYLE_EMPTY focuscolor 1 1 1 1 onEsc { scriptMenuResponse "close"; close self; close opencj_shop; close opencj_ingame; }
 itemDef { name dialog rect 140 155 360 175 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT style WINDOW_STYLE_FILLED backcolor .015 .025 .03 1 visible 1 decoration }
 itemDef { name accent rect 140 155 360 2 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT style WINDOW_STYLE_FILLED backcolor 0 .8 .9 1 visible 1 decoration }
 itemDef { name title rect 154 166 280 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT text "ITEM DETAILS" textfont UI_FONT_NORMAL textscale .28 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 0 .85 .95 1 visible 1 decoration }
 itemDef { name close rect 466 166 22 20 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED backcolor .5 .04 .04 .9 forecolor .92 .96 .97 1 text "X" textfont UI_FONT_NORMAL textscale .21 textalign ITEM_ALIGN_MIDDLE_CENTER visible 1 mouseEnter { setitemcolor close backcolor .08 .38 .44 1; } mouseExit { setitemcolor close backcolor .5 .04 .04 .9; } action { play "mouse_click"; scriptMenuResponse "close"; close self; close opencj_shop; close opencj_ingame; } }
 itemDef { name name rect 154 196 330 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT dvar "ocj_shop_confirm_name" textfont UI_FONT_NORMAL textscale .25 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .94 .95 1 visible 1 decoration }
 itemDef { name price rect 154 221 330 20 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT dvar "ocj_shop_confirm_cost" textfont UI_FONT_NORMAL textscale .22 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 0 .85 .95 1 visible 1 decoration }
 itemDef { name disabled rect 154 248 330 18 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT text "Currently unavailable for purchase" textfont UI_FONT_NORMAL textscale .20 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .65 .69 .71 1 visible when (!dvarInt("ocj_shop_confirm_buy") && !dvarInt("ocj_shop_confirm_owned")) decoration }
 itemDef { name owned rect 154 248 330 18 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT text "Purchased" textfont UI_FONT_NORMAL textscale .20 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .5 .9 .65 1 visible when (dvarInt("ocj_shop_confirm_owned")) decoration }
 itemDef { name question rect 154 248 330 18 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT text "Buy this item for the price shown above?" textfont UI_FONT_NORMAL textscale .20 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .9 .94 .95 1 visible when (dvarInt("ocj_shop_confirm_buy")) decoration }
 itemDef { name inspectError rect 154 267 330 16 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT dvar "ocj_shop_detail_error" textfont UI_FONT_NORMAL textscale .17 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .95 .65 .5 1 visible 1 decoration }
 itemDef { name back rect 154 286 80 26 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED backcolor .10 .19 .22 1 forecolor .92 .96 .97 1 text "Back" textfont UI_FONT_NORMAL textscale .21 textalign ITEM_ALIGN_MIDDLE_CENTER visible 1 mouseEnter { setitemcolor back backcolor .08 .38 .44 1; } mouseExit { setitemcolor back backcolor .10 .19 .22 1; } action { play "mouse_click"; close self; open opencj_shop; } }
 itemDef { name inspect rect 242 286 116 26 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED backcolor .10 .19 .22 1 forecolor .92 .96 .97 1 text "Inspect" textfont UI_FONT_NORMAL textscale .21 textalign ITEM_ALIGN_MIDDLE_CENTER visible 1 mouseEnter { setitemcolor inspect backcolor .08 .38 .44 1; } mouseExit { setitemcolor inspect backcolor .10 .19 .22 1; } action { play "mouse_click"; scriptMenuResponse "inspect"; } }
 itemDef { name buy rect 366 286 120 26 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED backcolor .10 .19 .22 1 forecolor .92 .96 .97 1 text "Purchase" textfont UI_FONT_NORMAL textscale .21 textalign ITEM_ALIGN_MIDDLE_CENTER visible when (dvarInt("ocj_shop_confirm_buy")) mouseEnter { setitemcolor buy backcolor .08 .38 .44 1; } mouseExit { setitemcolor buy backcolor .10 .19 .22 1; } action { play "mouse_click"; scriptMenuResponse "confirm"; } }
 itemDef { name equip rect 366 286 120 26 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED backcolor .10 .19 .22 1 forecolor .92 .96 .97 1 text "Equip" textfont UI_FONT_NORMAL textscale .21 textalign ITEM_ALIGN_MIDDLE_CENTER visible when (dvarInt("ocj_shop_confirm_owned") && !dvarInt("ocj_shop_confirm_equipped")) mouseEnter { setitemcolor equip backcolor .08 .38 .44 1; } mouseExit { setitemcolor equip backcolor .10 .19 .22 1; } action { play "mouse_click"; scriptMenuResponse "equip"; } }
 itemDef { name equipped rect 366 286 120 26 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT style WINDOW_STYLE_FILLED backcolor .06 .24 .14 1 type ITEM_TYPE_TEXT text "Equipped" textfont UI_FONT_NORMAL textscale .21 textalign ITEM_ALIGN_MIDDLE_CENTER forecolor .5 .9 .65 1 visible when (dvarInt("ocj_shop_confirm_owned") && dvarInt("ocj_shop_confirm_equipped")) decoration }
 itemDef { name locked rect 366 286 120 26 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT style WINDOW_STYLE_FILLED backcolor .07 .09 .1 1 visible when (!dvarInt("ocj_shop_confirm_owned") && !dvarInt("ocj_shop_confirm_buy")) decoration }
 itemDef { name lockedText rect 366 286 120 26 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT type ITEM_TYPE_TEXT text "Unavailable" textfont UI_FONT_NORMAL textscale .21 textalign ITEM_ALIGN_MIDDLE_CENTER forecolor .42 .48 .5 1 visible when (!dvarInt("ocj_shop_confirm_owned") && !dvarInt("ocj_shop_confirm_buy")) decoration }
 }
}
