#include "ui/menudef.h"
#include "ui_mp/scriptmenus/opencj_fps_registration.inc"
#include "ui_mp/scriptmenus/opencj_scoreboard_setup.inc"
{
    menuDef
    {
        name "opencj_client_init"
        rect 0 0 640 480
        onOpen
        {
            // Capture only once, before login applies the player's graphics.
            execNowOnDvarIntValue opencj_init_once 1 "setfromdvar opencj_gfx_map_sunShadow sm_sunEnable";
            execNowOnDvarIntValue opencj_init_once 1 "setfromdvar opencj_gfx_map_spotShadow sm_spotEnable";
            execNowOnDvarIntValue opencj_init_once 1 "setfromdvar opencj_gfx_map_blur r_blur";
            OPENCJ_SETUP_SCOREBOARD(execNowOnDvarIntValue opencj_init_once 1)
            OPENCJ_REGISTER_FPS(execNowOnDvarIntValue opencj_init_fps 1)
            setDvar opencj_init_once 0;
            scriptMenuResponse "ready";
            close opencj_client_init;
        }
    }
}
