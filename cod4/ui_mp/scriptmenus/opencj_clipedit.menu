#include "ui/menudef.h"
#include "ui_mp/scriptmenus/opencj_common.inc"

{
 menuDef {
  name opencj_clipedit
  rect 0 0 640 480
  style WINDOW_STYLE_EMPTY
  popup
  focuscolor WHITE_COLOR
  onOpen { execnow "setu opencj_clip_description Clip"; setdvar opencj_clip_description ""; setdvar ui_opencj_clip_name ""; setdvar opencj_clip_hint "32 characters: letters, numbers and spaces. Green: save | Red: load."; }
  onEsc { scriptMenuResponse "stop"; close self; }
  itemDef { name panel rect 0 0 640 164 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 0 316 style WINDOW_STYLE_FILLED backcolor 0 0 0 0.85 visible 1 decoration }
  itemDef { name accent rect 0 0 640 1 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 0 316 style WINDOW_STYLE_FILLED backcolor 0 0.8 0.9 1 visible 1 decoration }
  itemDef { name title rect 0 0 170 20 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 20 326 type ITEM_TYPE_TEXT text "CLIP EDITOR" textfont UI_FONT_NORMAL textscale 0.25 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 0 0.8 0.9 1 visible 1 decoration }
  itemDef { name hint rect 0 0 424 20 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 196 326 type ITEM_TYPE_TEXT dvar "opencj_clip_hint" textfont UI_FONT_NORMAL textscale 0.2 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 1 1 1 1 visible 1 decoration }
  itemDef { name description_label rect 0 0 70 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 20 352 type ITEM_TYPE_TEXT text "Description:" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .7 .7 .7 1 visible 1 decoration }
  itemDef { name description rect 0 0 256 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 94 352 type ITEM_TYPE_EDITFIELD text " " dvar "ui_opencj_clip_name" maxChars 32 maxPaintChars 32 textfont UI_FONT_NORMAL textscale .24 textalign ITEM_ALIGN_LEFT textalignx 4 textaligny 16 style WINDOW_STYLE_FILLED backcolor .17 .21 .23 .98 border WINDOW_BORDER_FULL bordersize 1 bordercolor .3 .55 .6 1 forecolor 1 1 1 1 visible 1 action { play "mouse_click"; } }
  itemDef { name storage_label rect 0 0 48 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 368 352 type ITEM_TYPE_TEXT text "Keep clip:" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor .7 .7 .7 1 visible 1 decoration }
  itemDef { name storage rect 0 0 112 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 418 352 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL bordersize 1 bordercolor .2 .4 .44 1 backcolor .10 .19 .22 .95 forecolor 1 1 1 1 dvar "opencj_clip_storage" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_CENTER visible 1 mouseEnter { setitemcolor storage backcolor .08 .38 .44 1; } mouseExit { setitemcolor storage backcolor .10 .19 .22 .95; } action { play "mouse_click"; scriptMenuResponse "storage"; } }
  itemDef { name submit rect 0 0 78 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 542 352 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL bordersize 1 bordercolor .2 .4 .44 1 backcolor 0 0.8 0.9 1 forecolor 0 0 0 1 text "Submit" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_CENTER visible 1 mouseEnter { setitemcolor submit backcolor .08 .38 .44 1; } mouseExit { setitemcolor submit backcolor 0 0.8 0.9 1; } action { play "mouse_click"; execnow "setfromdvar opencj_clip_description ui_opencj_clip_name"; scriptMenuResponse "submit"; } }
  itemDef { name trim rect 0 0 340 18 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 20 378 type ITEM_TYPE_TEXT dvar "opencj_clip_trim" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 1 1 1 1 visible 1 decoration }
  itemDef { name clock rect 0 0 250 18 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 370 378 type ITEM_TYPE_TEXT dvar "opencj_demo_status" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_LEFT forecolor 1 1 1 1 visible 1 decoration }
  itemDef { name mark_start rect 0 0 110 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 20 398 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL bordersize 1 bordercolor .2 .4 .44 1 backcolor .10 .19 .22 .95 forecolor 1 1 1 1 text "Set start here" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_CENTER visible 1 mouseEnter { setitemcolor mark_start backcolor .08 .38 .44 1; } mouseExit { setitemcolor mark_start backcolor .10 .19 .22 .95; } action { play "mouse_click"; scriptMenuResponse "start"; } }
  itemDef { name mark_end rect 0 0 110 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 136 398 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL bordersize 1 bordercolor .2 .4 .44 1 backcolor .10 .19 .22 .95 forecolor 1 1 1 1 text "Set end here" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_CENTER visible 1 mouseEnter { setitemcolor mark_end backcolor .08 .38 .44 1; } mouseExit { setitemcolor mark_end backcolor .10 .19 .22 .95; } action { play "mouse_click"; scriptMenuResponse "end"; } }
