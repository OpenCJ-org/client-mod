  itemDef { name all rect 0 0 100 22 HORIZONTAL_ALIGN_DEFAULT VERTICAL_ALIGN_DEFAULT origin 464 398 type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED border WINDOW_BORDER_FULL bordersize 1 bordercolor .2 .4 .44 1 backcolor .10 .19 .22 .95 forecolor 1 1 1 1 text "View full clip" textfont UI_FONT_NORMAL textscale 0.23 textalign ITEM_ALIGN_MIDDLE_CENTER visible 1 mouseEnter { setitemcolor all backcolor .08 .38 .44 1; } mouseExit { setitemcolor all backcolor .10 .19 .22 .95; } action { play "mouse_click"; scriptMenuResponse "all"; } }
