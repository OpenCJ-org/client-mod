#include "ui/menudef.h"

#include "ui_mp/scriptmenus/opencj_common.inc"

// Local palette: keep the main menu consistent without changing other menus.
#define IG_PANEL_COLOR       .015 .025 .03 .98
#define IG_NAV_COLOR         .025 .045 .052 1
#define IG_CENTER_COLOR      .02 .032 .038 1
#define IG_DIVIDER_COLOR     .10 .23 .26 .65
#define IG_TEXT_COLOR        .90 .94 .95 1
#define IG_MUTED_COLOR       .50 .59 .62 1
#define IG_DISABLED_COLOR    .34 .39 .41 1
#define IG_BUTTON_COLOR      .10 .19 .22 .95
#define IG_HOVER_COLOR       .08 .38 .44 1
#define IG_FEATURE_COLOR     .035 .065 .075 1

#define IG_NAV_BUTTON(_name, _text, _action, _backColor, _foreColor, _font, _scale, _x, _y, _w, _h) \
    itemDef { \
        name _name \
        rect DEFAULT_RECT(_x _y _w _h) \
        type ITEM_TYPE_BUTTON style WINDOW_STYLE_FILLED \
        backcolor _backColor forecolor _foreColor \
        text _text textfont _font textscale _scale \
        textalign ITEM_ALIGN_MIDDLE_CENTER \
        visible 1 \
        mouseEnter { setitemcolor _name backcolor IG_HOVER_COLOR; play "mouse_over"; } \
        mouseExit { setitemcolor _name backcolor _backColor; } \
        action { _action } \
    }

#define ADDPREFIX(val)  OPENCJDVAR("ig_")val

#define BORDER_ORG_FIX(val)       (val-1)
#define BORDER_SIZE_FIX(val)      (val+1)

// Outer frame things

#define ELEMENT_SPACING           2 // Spacing between each part (left, center, right)

#define IG_OUTER_FRAME_SIZE_X        400
#define IG_OUTER_FRAME_SIZE_Y        268
#define IG_OUTER_FRAME_ORG_X         ((FULLSCREEN_X - IG_OUTER_FRAME_SIZE_X) / 2)
#define IG_OUTER_FRAME_ORG_Y         ((FULLSCREEN_Y - IG_OUTER_FRAME_SIZE_Y) / 2)

// Left frame things

#define LEFT_SPACING              10

    // Background
#define IG_LEFT_FRAME_SIZE_X         80
#define IG_LEFT_FRAME_SIZE_Y         (IG_OUTER_FRAME_SIZE_Y - (2 * ELEMENT_SPACING))
#define IG_LEFT_FRAME_ORG_X          (IG_OUTER_FRAME_ORG_X + ELEMENT_SPACING)
#define IG_LEFT_FRAME_ORG_Y          (IG_OUTER_FRAME_ORG_Y + ELEMENT_SPACING)

    // Logo
#define OPENCJ_LOGO_SIZE_X        (50 - (2 * LEFT_SPACING))
#define OPENCJ_LOGO_SIZE_Y        OPENCJ_LOGO_SIZE_X // Square
#define OPENCJ_LOGO_OFFSET_X      ((IG_LEFT_FRAME_SIZE_X - OPENCJ_LOGO_SIZE_X) / 2)
#define OPENCJ_LOGO_ORG_X         (IG_LEFT_FRAME_ORG_X + OPENCJ_LOGO_OFFSET_X)
#define OPENCJ_LOGO_ORG_Y         (IG_LEFT_FRAME_ORG_Y + 0)

    // Buttons
#define ACTION_COMMON          play "mouse_click"; close self
#define ACTION_PLAY            ACTION_COMMON; exec "spawn"
#define ACTION_SPEC            ACTION_COMMON; exec "spectate"
#define ACTION_RUN             ACTION_COMMON; exec "openrunsboard"
#define ACTION_LB              ACTION_COMMON; exec "openleaderboard"
#define ACTION_MAPLIST         ACTION_COMMON; exec "openmaplist"

#define BTN_SIZE_X            (IG_LEFT_FRAME_SIZE_X - (2 * LEFT_SPACING))
#define BTN_SIZE_Y            20
#define BTN_SPACING           2
#define BTN_GROUP_SPACING     8
    // For active buttons:
#define BTN_BACKCOLOR         IG_BUTTON_COLOR
#define BTN_FORECOLOR         IG_TEXT_COLOR
#define BTN_FONT              UI_FONT_NORMAL
#define BTN_FONTSIZE          0.24
    // For inactive buttons:
#define IBTN_BACKCOLOR        NO_COLOR

#define GRP_BG_SPACING        1
    // Group 1: play & spectate


#define BTN_PLAY_SIZE_X        BTN_SIZE_X
#define BTN_PLAY_SIZE_Y        BTN_SIZE_Y
#define BTN_PLAY_ORG_X         (IG_LEFT_FRAME_ORG_X + LEFT_SPACING)
#define BTN_PLAY_ORG_Y         (OPENCJ_LOGO_ORG_Y + OPENCJ_LOGO_SIZE_Y)

#define BTN_SPEC_SIZE_X        BTN_SIZE_X
#define BTN_SPEC_SIZE_Y        BTN_SIZE_Y
#define BTN_SPEC_ORG_X         BTN_PLAY_ORG_X
#define BTN_SPEC_ORG_Y         (BTN_PLAY_ORG_Y + BTN_PLAY_SIZE_Y + BTN_SPACING)

    // Runs, leaderboard and challenges; clips and map list form the next group.

#define BTN_RUNS_SIZE_X        BTN_SIZE_X
#define BTN_RUNS_SIZE_Y        BTN_SIZE_Y
#define BTN_RUNS_ORG_X         BTN_PLAY_ORG_X
#define BTN_RUNS_ORG_Y         (BTN_SPEC_ORG_Y + BTN_SPEC_SIZE_Y + BTN_GROUP_SPACING)

#define BTN_LB_SIZE_X          BTN_SIZE_X
#define BTN_LB_SIZE_Y          BTN_SIZE_Y
#define BTN_LB_ORG_X           BTN_RUNS_ORG_X
#define BTN_LB_ORG_Y           (BTN_RUNS_ORG_Y + BTN_RUNS_SIZE_Y + BTN_SPACING)

#define BTN_CLIPS_SIZE_X      BTN_SIZE_X
#define BTN_CLIPS_SIZE_Y      BTN_SIZE_Y
#define BTN_CLIPS_ORG_X       BTN_LB_ORG_X
#define BTN_CLIPS_ORG_Y     (BTN_CHALL_ORG_Y + BTN_CHALL_SIZE_Y + BTN_GROUP_SPACING)

#define BTN_CHALL_SIZE_X       BTN_SIZE_X
#define BTN_CHALL_SIZE_Y       BTN_SIZE_Y
#define BTN_CHALL_ORG_X        BTN_CLIPS_ORG_X
#define BTN_CHALL_ORG_Y     (BTN_LB_ORG_Y + BTN_LB_SIZE_Y + BTN_SPACING)

    // Shop has its own group.

#define BTN_SHOP_SIZE_X        BTN_SIZE_X
#define BTN_SHOP_SIZE_Y        BTN_SIZE_Y
#define BTN_SHOP_ORG_X         BTN_CHALL_ORG_X
#define BTN_SHOP_ORG_Y     (BTN_MAPLIST_ORG_Y + BTN_MAPLIST_SIZE_Y + BTN_GROUP_SPACING)

    // Map list belongs with clips; servers have their own final group.

#define BTN_MAPLIST_SIZE_X     BTN_SIZE_X
#define BTN_MAPLIST_SIZE_Y     BTN_SIZE_Y
#define BTN_MAPLIST_ORG_X      BTN_SHOP_ORG_X
#define BTN_MAPLIST_ORG_Y     (BTN_CLIPS_ORG_Y + BTN_CLIPS_SIZE_Y + BTN_SPACING)

#define BTN_SERVERS_SIZE_X     BTN_SIZE_X
#define BTN_SERVERS_SIZE_Y     BTN_SIZE_Y
#define BTN_SERVERS_ORG_X      BTN_MAPLIST_ORG_X
#define BTN_SERVERS_ORG_Y     (BTN_SHOP_ORG_Y + BTN_SHOP_SIZE_Y + BTN_GROUP_SPACING)

// Center frame things
#define CENTER_SPACING            15
    // Background
#define CENTER_FRAME_SIZE_X       280
#define CENTER_FRAME_SIZE_Y       IG_LEFT_FRAME_SIZE_Y
#define CENTER_FRAME_ORG_X        (IG_LEFT_FRAME_ORG_X + IG_LEFT_FRAME_SIZE_X + ELEMENT_SPACING)
#define CENTER_FRAME_ORG_Y        IG_LEFT_FRAME_ORG_Y

    // MOTD: title
#define MOTD_TITLE_ORG_X          (IG_LEFT_FRAME_ORG_X + IG_LEFT_FRAME_SIZE_X + CENTER_SPACING + ELEMENT_SPACING)
#define MOTD_TITLE_ORG_Y          (OPENCJ_LOGO_ORG_Y + (OPENCJ_LOGO_SIZE_Y / 2))
#define MOTD_TITLE_SIZE_X         (CENTER_FRAME_SIZE_X - (2 * CENTER_SPACING))
#define MOTD_TITLE_SIZE_Y         25

    // MOTD: content
#define MOTD_CONTENT_SIZE_X       (CENTER_FRAME_SIZE_X - (2 * CENTER_SPACING))
#define MOTD_CONTENT_SIZE_Y       20
#define MOTD_CONTENT_ORG_X        MOTD_TITLE_ORG_X
#define MOTD_CONTENT_ORG_Y        (MOTD_TITLE_ORG_Y + MOTD_TITLE_SIZE_Y + CENTER_SPACING)

    // MOTD: date
#define MOTD_DATE_SIZE_X          MOTD_CONTENT_SIZE_X
#define MOTD_DATE_SIZE_Y          10
#define MOTD_DATE_ORG_X           MOTD_CONTENT_ORG_X
#define MOTD_DATE_ORG_Y           (CENTER_FRAME_ORG_Y + CENTER_FRAME_SIZE_Y - MOTD_DATE_SIZE_Y - CENTER_SPACING)

    // Button: give feedback
#define BTN_FEEDBACK_SIZE_X    BTN_PLAY_SIZE_X
#define BTN_FEEDBACK_SIZE_Y    BTN_PLAY_SIZE_Y
#define BTN_FEEDBACK_ORG_X     MOTD_DATE_ORG_X
#define BTN_FEEDBACK_ORG_Y     BTN_SERVERS_ORG_Y

// Right frame things
#define RIGHT_SPACING             LEFT_SPACING
    // Background
#define RIGHT_FRAME_SIZE_X        (IG_OUTER_FRAME_SIZE_X - IG_LEFT_FRAME_SIZE_X - CENTER_FRAME_SIZE_X - (4 * ELEMENT_SPACING))
#define RIGHT_FRAME_SIZE_Y        CENTER_FRAME_SIZE_Y
#define RIGHT_FRAME_ORG_X         (CENTER_FRAME_ORG_X + CENTER_FRAME_SIZE_X + ELEMENT_SPACING)
#define RIGHT_FRAME_ORG_Y         CENTER_FRAME_ORG_Y

    // Icon: rank
#define RANK_ICON_SIZE_X          15
#define RANK_ICON_SIZE_Y          RANK_ICON_SIZE_X // Square
#define RANK_ICON_ORG_X           (RIGHT_FRAME_ORG_X + ((RIGHT_FRAME_SIZE_X - RANK_ICON_SIZE_X) / 2))
#define RANK_ICON_ORG_Y           (OPENCJ_LOGO_ORG_Y + RIGHT_SPACING)

// The following buttons are from bottom to top

    // Button: leave game
#define BTN_LEAVE_SIZE_X    20
#define BTN_LEAVE_SIZE_Y    BTN_LEAVE_SIZE_X // Square
#define BTN_LEAVE_ORG_X     (RIGHT_FRAME_ORG_X + ((RIGHT_FRAME_SIZE_X - BTN_LEAVE_SIZE_X) / 2))
#define BTN_LEAVE_ORG_Y     (RIGHT_FRAME_ORG_Y + RIGHT_FRAME_SIZE_Y - BTN_LEAVE_SIZE_Y - RIGHT_SPACING)

    // Button: settings
#define BTN_SETTINGS_SIZE_X       BTN_LEAVE_SIZE_X
#define BTN_SETTINGS_SIZE_Y       BTN_LEAVE_SIZE_Y
#define BTN_SETTINGS_ORG_X        BTN_LEAVE_ORG_X
#define BTN_SETTINGS_ORG_Y        (BTN_LEAVE_ORG_Y - RIGHT_SPACING - BTN_LEAVE_SIZE_Y)

    // Button: controls
#define BTN_CONTROLS_SIZE_X       BTN_SETTINGS_SIZE_X
#define BTN_CONTROLS_SIZE_Y       BTN_SETTINGS_SIZE_Y
#define BTN_CONTROLS_ORG_X        BTN_SETTINGS_ORG_X
#define BTN_CONTROLS_ORG_Y        (BTN_SETTINGS_ORG_Y - RIGHT_SPACING - BTN_SETTINGS_SIZE_Y)

{
    menuDef
    {
        name        opencj_ingame
        rect        DEFAULT_RECT(0 0 FULLSCREEN_X FULLSCREEN_Y)
        focuscolor  COLOR_UNFOCUSED
        style       WINDOW_STYLE_EMPTY
        blurWorld   2.0
        onEsc
        {
            close self;
        }
        execKey "1" { ACTION_PLAY }
        execKey "2" { ACTION_SPEC }
        execKey "3" { ACTION_RUN  }
        execKey "4" { ACTION_LB   }

        execKey "r" { ACTION_RUN  }
        execKey "l" { ACTION_LB   }
        execKey "m" { ACTION_MAPLIST }

    // Frame background
        FIXED_RECT(IG_PANEL_COLOR, IG_OUTER_FRAME_ORG_X, IG_OUTER_FRAME_ORG_Y, IG_OUTER_FRAME_SIZE_X, IG_OUTER_FRAME_SIZE_Y)

    // Left side frame
        // Background
        FIXED_RECT(IG_NAV_COLOR, IG_LEFT_FRAME_ORG_X, IG_LEFT_FRAME_ORG_Y, IG_LEFT_FRAME_SIZE_X, IG_LEFT_FRAME_SIZE_Y)

        FIXED_RECT(IG_DIVIDER_COLOR, (IG_LEFT_FRAME_ORG_X + IG_LEFT_FRAME_SIZE_X), IG_LEFT_FRAME_ORG_Y, 1, IG_LEFT_FRAME_SIZE_Y)

        // OpenCJ logo
        SHADER_RECT_ALWAYS(opencj_logo, opencj_logo_nobg, OPENCJ_LOGO_ORG_X, OPENCJ_LOGO_ORG_Y, OPENCJ_LOGO_SIZE_X, OPENCJ_LOGO_SIZE_Y)

            // Buttons: play
        IG_NAV_BUTTON(btn_play, "Play", ACTION_PLAY, BTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_PLAY_ORG_X, BTN_PLAY_ORG_Y, BTN_PLAY_SIZE_X, BTN_PLAY_SIZE_Y)
            // Buttons: spectate
        IG_NAV_BUTTON(btn_spec, "Spectate", ACTION_SPEC, BTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_SPEC_ORG_X, BTN_SPEC_ORG_Y, BTN_SPEC_SIZE_X, BTN_SPEC_SIZE_Y)

            // Buttons: runs
        IG_NAV_BUTTON(btn_runs, "Runs", ACTION_RUN, BTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_RUNS_ORG_X, BTN_RUNS_ORG_Y, BTN_RUNS_SIZE_X, BTN_RUNS_SIZE_Y)
            // Buttons: leaderboard
        IG_NAV_BUTTON(btn_lb, "Leaderboard", ACTION_LB, BTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_LB_ORG_X, BTN_LB_ORG_Y, BTN_LB_SIZE_X, BTN_LB_SIZE_Y)
            // Buttons: clips
        IG_NAV_BUTTON(btn_clips, "Clips", ACTION_COMMON; open opencj_clips, BTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_CLIPS_ORG_X, BTN_CLIPS_ORG_Y, BTN_CLIPS_SIZE_X, BTN_CLIPS_SIZE_Y)
            // Buttons: challenges
        IG_NAV_BUTTON(btn_challenges, "Challenges", ACTION_COMMON; open opencj_challenges, BTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_CHALL_ORG_X, BTN_CHALL_ORG_Y, BTN_CHALL_SIZE_X, BTN_CHALL_SIZE_Y)

            // Buttons: shop
        IG_NAV_BUTTON(btn_shop, "Shop", ACTION_COMMON; open opencj_shop, BTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_SHOP_ORG_X, BTN_SHOP_ORG_Y, BTN_SHOP_SIZE_X, BTN_SHOP_SIZE_Y)

            // Buttons: map list
        IG_NAV_BUTTON(btn_maplist, "Maplist", ACTION_MAPLIST, BTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_MAPLIST_ORG_X, BTN_MAPLIST_ORG_Y, BTN_MAPLIST_SIZE_X, BTN_MAPLIST_SIZE_Y)
            // Button: servers
        FIXED_RECT_TXT(1, "Servers", BTN_FONT, ITEM_TEXTSTYLE_NORMAL, BTN_FONTSIZE, ITEM_ALIGN_MIDDLE_CENTER, 0, 0, NO_COLOR, IG_DISABLED_COLOR, BTN_SERVERS_ORG_X, BTN_SERVERS_ORG_Y, BTN_SERVERS_SIZE_X, BTN_SERVERS_SIZE_Y)


    // Center frame
        // Background
        FIXED_RECT(IG_CENTER_COLOR, CENTER_FRAME_ORG_X, CENTER_FRAME_ORG_Y, CENTER_FRAME_SIZE_X, CENTER_FRAME_SIZE_Y)

        // MOTD: title
        FIXED_RECT_DVARLEFT_STYLED(ADDPREFIX("motd_title"), UI_FONT_NORMAL, 0.34, NO_COLOR, HIGHLIGHT_COLOR, MOTD_TITLE_ORG_X, MOTD_TITLE_ORG_Y, MOTD_TITLE_SIZE_X, MOTD_TITLE_SIZE_Y)

        FIXED_RECT(IG_DIVIDER_COLOR, MOTD_TITLE_ORG_X, (MOTD_TITLE_ORG_Y + MOTD_TITLE_SIZE_Y + 4), MOTD_CONTENT_SIZE_X, 1)

        // MOTD: content
        itemDef
        {
            FIXED_RECT_TEXT_BASE(UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL, 0.23, ITEM_ALIGN_LEFT, 0, 10, NO_COLOR, IG_TEXT_COLOR, MOTD_CONTENT_ORG_X, MOTD_CONTENT_ORG_Y, MOTD_CONTENT_SIZE_X, 88)
            dvar ADDPREFIX("motd_content")
            autowrapped
            visible 1
        }

        // An inset groups release notes without splitting the outer panel.
        FIXED_RECT(IG_FEATURE_COLOR, (MOTD_CONTENT_ORG_X - 6), (MOTD_CONTENT_ORG_Y + 80), (MOTD_CONTENT_SIZE_X + 12), 101)
        FIXED_RECT(HIGHLIGHT_COLOR, (MOTD_CONTENT_ORG_X - 6), (MOTD_CONTENT_ORG_Y + 80), 1, 101)
        // Latest features: small square bullets avoid font-specific glyphs.
        FIXED_RECT_TXT(1, "Latest features", UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL, 0.26, ITEM_ALIGN_MIDDLE_LEFT, 0, 0, NO_COLOR, HIGHLIGHT_COLOR, MOTD_CONTENT_ORG_X, (MOTD_CONTENT_ORG_Y + 84), MOTD_CONTENT_SIZE_X, 18)
        FIXED_RECT(HIGHLIGHT_COLOR, MOTD_CONTENT_ORG_X, (MOTD_CONTENT_ORG_Y + 112), 2, 2)
        FIXED_RECT_TXT(1, "Checkpoint creation tooling", UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL, 0.23, ITEM_ALIGN_MIDDLE_LEFT, 0, 0, NO_COLOR, IG_TEXT_COLOR, (MOTD_CONTENT_ORG_X + 8), (MOTD_CONTENT_ORG_Y + 106), (MOTD_CONTENT_SIZE_X - 8), 14)
        FIXED_RECT(HIGHLIGHT_COLOR, MOTD_CONTENT_ORG_X, (MOTD_CONTENT_ORG_Y + 126), 2, 2)
        FIXED_RECT_TXT(1, "New & revamped menus", UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL, 0.23, ITEM_ALIGN_MIDDLE_LEFT, 0, 0, NO_COLOR, IG_TEXT_COLOR, (MOTD_CONTENT_ORG_X + 8), (MOTD_CONTENT_ORG_Y + 120), (MOTD_CONTENT_SIZE_X - 8), 14)
        FIXED_RECT(HIGHLIGHT_COLOR, MOTD_CONTENT_ORG_X, (MOTD_CONTENT_ORG_Y + 140), 2, 2)
        FIXED_RECT_TXT(1, "Demos & clips", UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL, 0.23, ITEM_ALIGN_MIDDLE_LEFT, 0, 0, NO_COLOR, IG_TEXT_COLOR, (MOTD_CONTENT_ORG_X + 8), (MOTD_CONTENT_ORG_Y + 134), (MOTD_CONTENT_SIZE_X - 8), 14)
        FIXED_RECT(HIGHLIGHT_COLOR, MOTD_CONTENT_ORG_X, (MOTD_CONTENT_ORG_Y + 154), 2, 2)
        FIXED_RECT_TXT(1, "Challenges & ranks", UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL, 0.23, ITEM_ALIGN_MIDDLE_LEFT, 0, 0, NO_COLOR, IG_TEXT_COLOR, (MOTD_CONTENT_ORG_X + 8), (MOTD_CONTENT_ORG_Y + 148), (MOTD_CONTENT_SIZE_X - 8), 14)
        FIXED_RECT(HIGHLIGHT_COLOR, MOTD_CONTENT_ORG_X, (MOTD_CONTENT_ORG_Y + 168), 2, 2)
        FIXED_RECT_TXT(1, "Shop & equip system", UI_FONT_NORMAL, ITEM_TEXTSTYLE_NORMAL, 0.23, ITEM_ALIGN_MIDDLE_LEFT, 0, 0, NO_COLOR, IG_TEXT_COLOR, (MOTD_CONTENT_ORG_X + 8), (MOTD_CONTENT_ORG_Y + 162), (MOTD_CONTENT_SIZE_X - 8), 14)

        // MOTD: date
        FIXED_RECT_DVARLEFT_STYLED(ADDPREFIX("motd_date"), UI_FONT_NORMAL, 0.19, NO_COLOR, IG_MUTED_COLOR, MOTD_DATE_ORG_X, MOTD_DATE_ORG_Y, MOTD_DATE_SIZE_X, MOTD_DATE_SIZE_Y)

        // Page button: forward in time (not implemented yet)

        // Page button: backward in time(not implemented yet)

        // Page button: give feedback
        //BUTTON_RECT_TXT(btn_feedback, "Give feedback", "", IBTN_BACKCOLOR, BTN_FORECOLOR, BTN_FONT, BTN_FONTSIZE, BTN_FEEDBACK_ORG_X, BTN_FEEDBACK_ORG_Y, BTN_FEEDBACK_SIZE_X, BTN_FEEDBACK_SIZE_Y)

        // Page button: contribute (not implemented yet)


    // Right side frame
        // Background
        FIXED_RECT(IG_NAV_COLOR, RIGHT_FRAME_ORG_X, RIGHT_FRAME_ORG_Y, RIGHT_FRAME_SIZE_X, RIGHT_FRAME_SIZE_Y)

        FIXED_RECT(IG_DIVIDER_COLOR, RIGHT_FRAME_ORG_X, RIGHT_FRAME_ORG_Y, 1, RIGHT_FRAME_SIZE_Y)

        // Icon: rank
        SEL_DVARSHADER_RECT(rank_icon, ADDPREFIX("rank"), RANK_ICON_ORG_X, RANK_ICON_ORG_Y, RANK_ICON_SIZE_X, RANK_ICON_SIZE_Y)

        // Button: controls
        BUTTON_RECT_TXT_ACTION(btn_controls, "", play "mouse_click"; close self; open main_controls, NO_COLOR, WHITE_COLOR, UI_FONT_NORMAL, 0.24, BTN_CONTROLS_ORG_X, BTN_CONTROLS_ORG_Y, 20, 20)
        FIXED_RECT_BORDER(NO_COLOR, 1, WHITE_COLOR, (BTN_CONTROLS_ORG_X + 1), (BTN_CONTROLS_ORG_Y + 4), 18, 12)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 5), (BTN_CONTROLS_ORG_Y + 7), 2, 1)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 9), (BTN_CONTROLS_ORG_Y + 7), 2, 1)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 13), (BTN_CONTROLS_ORG_Y + 7), 2, 1)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 5), (BTN_CONTROLS_ORG_Y + 10), 2, 1)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 9), (BTN_CONTROLS_ORG_Y + 10), 2, 1)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 13), (BTN_CONTROLS_ORG_Y + 10), 2, 1)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 6), (BTN_CONTROLS_ORG_Y + 13), 8, 1)

        // Mod graphics: monitor with a cyan landscape, above the stock controls.
        BUTTON_RECT_TXT_ACTION(btn_graphics, "", play "mouse_click"; close self; open opencj_graphics, NO_COLOR, WHITE_COLOR, UI_FONT_NORMAL, 0.24, BTN_CONTROLS_ORG_X, (BTN_CONTROLS_ORG_Y - 30), 20, 20)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 1), (BTN_CONTROLS_ORG_Y - 29), 18, 1)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 1), (BTN_CONTROLS_ORG_Y - 17), 18, 1)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 1), (BTN_CONTROLS_ORG_Y - 28), 1, 11)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 18), (BTN_CONTROLS_ORG_Y - 28), 1, 11)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 9), (BTN_CONTROLS_ORG_Y - 16), 2, 3)
        FIXED_RECT(WHITE_COLOR, (BTN_CONTROLS_ORG_X + 5), (BTN_CONTROLS_ORG_Y - 13), 10, 1)
        FIXED_RECT(HIGHLIGHT_COLOR, (BTN_CONTROLS_ORG_X + 9), (BTN_CONTROLS_ORG_Y - 26), 2, 1)
        FIXED_RECT(HIGHLIGHT_COLOR, (BTN_CONTROLS_ORG_X + 8), (BTN_CONTROLS_ORG_Y - 25), 4, 1)
        FIXED_RECT(HIGHLIGHT_COLOR, (BTN_CONTROLS_ORG_X + 7), (BTN_CONTROLS_ORG_Y - 24), 6, 1)
        FIXED_RECT(HIGHLIGHT_COLOR, (BTN_CONTROLS_ORG_X + 6), (BTN_CONTROLS_ORG_Y - 23), 8, 1)
        FIXED_RECT(HIGHLIGHT_COLOR, (BTN_CONTROLS_ORG_X + 5), (BTN_CONTROLS_ORG_Y - 22), 10, 1)
        FIXED_RECT(HIGHLIGHT_COLOR, (BTN_CONTROLS_ORG_X + 4), (BTN_CONTROLS_ORG_Y - 21), 12, 1)

        // Button: settings
        SEL_SHADER_RECT_ALWAYS_ACTION(btn_settings, close self; open main_options, opencj_icon_gear, BTN_SETTINGS_ORG_X, BTN_SETTINGS_ORG_Y, BTN_SETTINGS_SIZE_X, BTN_SETTINGS_SIZE_Y)

        // Button: leave game
        SEL_SHADER_RECT_ALWAYS_ACTION(btn_leave, execnow "bind TAB +scores"; execnow "set opencj_sb_held 0"; execnow "setu opencj_sb_active 0"; exec "disconnect", opencj_icon_exit, BTN_LEAVE_ORG_X, BTN_LEAVE_ORG_Y, BTN_LEAVE_SIZE_X, BTN_LEAVE_SIZE_Y)

        // Continuous accent above all three sections.
        FIXED_RECT(HIGHLIGHT_COLOR, IG_OUTER_FRAME_ORG_X, IG_OUTER_FRAME_ORG_Y, IG_OUTER_FRAME_SIZE_X, 2)
    } // menuDef
}